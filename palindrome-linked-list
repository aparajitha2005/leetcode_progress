# Definition for singly-linked list.
# class ListNode(object):
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution(object):
    def isPalindrome(self, head):
        fast, slow = head , head
        while fast and fast.next:
            slow = slow.next
            fast = fast.next.next
        if fast:
            slow = slow.next
        second = None
        while slow:
            nxt = slow.next
            slow.next = second
            second = slow
            slow = nxt
        first = head
        while second:
            if first.val != second.val:
                return False
            first = first.next
            second = second.next
        return True

